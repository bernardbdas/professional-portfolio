{
  "window.openFoldersInNewWindow": "off",
  "editor.wordWrap": "on",

  // LaTeX Workshop settings
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.view.pdf.tab.editorGroup": "right",
  "latex-workshop.latex.outDir": "%DIR%/builds",
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.recipe.default": "lastUsed",

  // Build recipes and tools
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ]
    },
    {
      "name": "latexmk (xelatex)",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-xelatex",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (pdflatex)",
      "tools": [
        "latexmk"
      ]
    },
    {
      "name": "latexmk (xelatex)",
      "tools": [
        "latexmk (xelatex)"
      ]
    }
  ],

  // Language specific settings
  "[latex]": {
    "editor.wordWrap": "on",
    "editor.formatOnSave": false,
    "editor.suggest.insertMode": "replace",
    "editor.tabSize": 2
  },
  "[tex]": {
    "editor.wordWrap": "on",
    "editor.tabSize": 2
  },

  // Dictionary / Spellchecker
  "cSpell.words": [
    "latexmk",
    "xelatex",
    "outdir",
    "pvc",
    "justfile",
    "abrilfatface",
    "merriweather",
    "officecodeprod",
    "sourcesanspro",
    "sourceserifpro",
    "bernardbdas"
  ],

  // Exclude auxiliary files
  "files.exclude": {
    "**/*.pyc": true,
    "**/*.pyo": true,
    "**/__pycache__": true,
    "**/.DS_Store": true,
    "**/*.ipynb_checkpoints": true,
    "**/.git": false,
    "**/*.aux": true,
    "**/*.out": true,
    "**/*.bbl": true,
    "**/*.bcf": true,
    "**/*.blg": true,
    "**/*.fdb_latexmk": true,
    "**/*.fls": true,
    "**/*.log": true,
    "**/*.lof": true,
    "**/*.lot": true,
    "**/*.nav": true,
    "**/*.pdf": false,
    "**/*.snm": true,
    "**/*.synctex": false,
    "**/*.synctex.gz": true,
    "**/*.toc": true,
    "**/*.vrb": true,
    "**/*.dvi": true,
    "**/*.xdv": true,
    "**/main.run.xml": true
  }
}
